# Server
PORT=5000
NODE_ENV=development

# Database (Laragon default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_farming_iot

# JWT
JWT_SECRET=ubah_ini_menjadi_string_panjang_random_minimal_32_karakter
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=ubah_ini_juga_string_panjang_random
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# Device offline threshold (detik)
DEVICE_OFFLINE_THRESHOLD=60